rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStringList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 120));
    }

    // Validation Blueprint for PrivateProfile (synchronized with firebase-blueprint.json)
    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint for PrivateInventory (synchronized with firebase-blueprint.json)
    function isValidPrivateInventory(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'ownedParts',
          'customParts',
          'completedLabs',
          'savedIdeaIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'ownedParts',
          'customParts',
          'completedLabs',
          'savedIdeaIds',
          'benchLayout',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.ownedParts is map
        && data.ownedParts.size() <= 60
        && isValidStringList(data.customParts, 40)
        && isValidStringList(data.completedLabs, 60)
        && isValidStringList(data.savedIdeaIds, 40)
        && (!('benchLayout' in data) || (data.benchLayout is map && data.benchLayout.size() <= 12))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint for CustomHardwareItem (synchronized with firebase-blueprint.json)
    function isValidCustomHardwareItem(data, userId, partId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'category',
          'quantity',
          'voltage',
          'interfaceSpec',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'category',
          'quantity',
          'voltage',
          'interfaceSpec',
          'notes',
          'photoDataUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == partId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.category is string
        && data.category in ['boards', 'wireless', 'display-audio', 'sensors', 'power-proto']
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 999
        && data.voltage is string
        && data.voltage.size() <= 40
        && data.interfaceSpec is string
        && data.interfaceSpec.size() <= 60
        && data.notes is string
        && data.notes.size() <= 400
        && (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 140000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Owner-only private profile (PII isolated)
    match /users/{userId}/private/profile {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt'])
        );

      allow delete: if isOwner(userId);
    }

    // Owner-only private hardware inventory & 3D bench layout
    match /users/{userId}/private/inventory {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidPrivateInventory(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidPrivateInventory(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['ownedParts', 'customParts', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['benchLayout', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['completedLabs', 'savedIdeaIds', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['ownedParts', 'customParts', 'completedLabs', 'savedIdeaIds', 'benchLayout', 'updatedAt'])
        );

      allow delete: if isOwner(userId);
    }

    // Owner-only custom hardware parts with captured/uploaded photos
    match /users/{userId}/custom_parts/{partId} {
      allow get: if isOwner(userId) && isValidId(partId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(partId)
        && isValidCustomHardwareItem(incoming(), userId, partId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(partId)
        && isValidCustomHardwareItem(incoming(), userId, partId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'quantity', 'voltage', 'interfaceSpec', 'notes', 'photoDataUrl', 'updatedAt'])
        );

      allow delete: if isOwner(userId) && isValidId(partId);
    }
  }
}
